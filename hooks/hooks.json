{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/volens-sync.sh\" Stop",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/volens-sync.sh\" SessionStart",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
