    "email": "142787769+funcpn@users.noreply.github.com"
  },
  "homepage": "https://github.com/funcpn/volens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funcpn/volens.git"
  },
  "bugs": {
    "url": "https://github.com/funcpn/volens/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
